[global]
    monitor = 0
    follow = keyboard
    width = 370
    height = (0,350)
    offset = (6,40)
    padding = 6
    horizontal_padding = 8
    frame_width = 3
    frame_color = "#98971a"
    font = Iosevka 10
    format = "<b>%s</b>\n%b"

    mouse_left_click = do_action, close_current
    mouse_middle_click = context
    mouse_right_click = close_current
    show_indicators = yes
    dmenu = dmenu -i -p action:
    browser = xdg-open

[urgency_low]
    background = "#1d2021"
    foreground = "#a89984"
    frame_color = "#504945"
    timeout = 3

[urgency_normal]
    background = "#1d2021"
    foreground = "#ebdbb2"
    timeout = 5

[urgency_critical]
    background = "#cc241d"
    foreground = "#ebdbb2"
    frame_color = "#fabd2f"
    timeout = 10
