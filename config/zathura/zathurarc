set font "Iosevka 12"
set recolor true
set recolor-keephue true
set recolor-lightcolor "#1d2021"
set recolor-darkcolor "#ebdbb2"
set default-bg "#1d2021"
set default-fg "#ebdbb2"
set statusbar-bg "#282828"
set statusbar-fg "#ebdbb2"
set inputbar-bg "#1d2021"
set inputbar-fg "#ebdbb2"
set notification-bg "#1d2021"
set notification-fg "#ebdbb2"
set notification-error-bg "#cc241d"
set notification-error-fg "#ebdbb2"
set notification-warning-bg "#d79921"
set notification-warning-fg "#1d2021"
set completion-bg "#282828"
set completion-fg "#ebdbb2"
set completion-group-bg "#1d2021"
set completion-group-fg "#a89984"
set completion-highlight-bg "#83a598"
set completion-highlight-fg "#1d2021"
set index-bg "#1d2021"
set index-fg "#ebdbb2"
set index-active-bg "#83a598"
set index-active-fg "#1d2021"
set highlight-color "rgba(250,189,47,0.4)"
set highlight-active-color "rgba(254,128,25,0.4)"

set selection-clipboard clipboard
map u scroll half-up
map d scroll half-down
map D toggle_page_mode
map r reload
map R rotate
map K zoom in
map J zoom out
map i recolor
map p print
map g goto top
