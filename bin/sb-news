#!/bin/sh

case $BLOCK_BUTTON in
        1) setsid "$TERMINAL" -e newsboat ;;
	2) setsid -f newsup >/dev/null && exit ;;
	6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

cat /tmp/newsupdate 2>/dev/null || {
	unread="$(newsboat -x print-unread)"
	unread="${unread%% *}"
	[ "$unread" -gt 0 ] && printf "📰%s\n" "$unread"
}
