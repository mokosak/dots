#!/bin/sh

cachedir="${XDG_CACHE_HOME:-"$HOME/.cache"}"
cache="$cachedir/dmenu_run"
# commands to leave out of the list, one per line
hidden="${XDG_CONFIG_HOME:-"$HOME/.config"}/dmenu/hidden"

[ ! -e "$cachedir" ] && mkdir -p "$cachedir"

IFS=:
if stest -dqr -n "$cache" $PATH || [ "$hidden" -nt "$cache" ]; then
	stest -flx $PATH | sort -u | if [ -r "$hidden" ]; then
		grep -vxFf "$hidden"
	else
		cat
	fi | tee "$cache"
else
	cat "$cache"
fi
